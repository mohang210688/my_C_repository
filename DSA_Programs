**** DSA-3 : Remove every nth node in a Linked List ****

struct node
{
    int data;
    struct node *next;
};

struct node* createNode(int input)
{
    struct node* new_node = (struct node *)malloc(sizeof(struct node));
    new_node->data = input;
    new_node->next = NULL;
}

struct node* insert_node(struct node* head, struct node* new_node)
{
	struct node* cur;

	if (head == NULL)
		return new_node;

	cur = head;

	while (cur && (cur->next != NULL))
	{
		cur = cur->next;
	}
	cur->next=new_node;
	return head;
}

struct node* remove_every_nth_node(struct node*head, int remove_every_n_node)
{
	struct node* cur;
	struct node* prev;
	struct node* temp;
	int node_cnt = 0;

	if (head == NULL) {
		printf("\nNo node to remove");
		return 0;
	}
	cur = head;
	prev = head;

	while(cur)
	{
		node_cnt++;
		if ((node_cnt % remove_every_n_node) != 0)
		{
			prev = cur;
			cur = cur->next;
		} else {
			prev->next = cur->next;
			temp= cur;
			cur = cur->next;
			free(temp);
			temp=NULL;
		}
	}
	return head;
}

void print_node(struct node* head)
{
	struct node* cur;

	if (head == NULL) {
		printf("\nNo node to display");
		return;
	}

	cur = head;

	while(cur)
	{
		printf(" %d ", cur->data);
		cur = cur->next;
	}
}

